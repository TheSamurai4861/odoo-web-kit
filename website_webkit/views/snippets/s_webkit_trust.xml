<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_webkit_trust" name="Web Kit Trust">
    <section class="s_webkit_trust o_cc o_cc1 pt96 pb96">
        <div class="container">
            <div class="row align-items-center g-4 g-xl-5">
                <div class="col-xl-7">
                    <blockquote class="webkit_quote position-relative mb-0 p-4 p-md-5">
                        <span class="webkit_quote_mark d-block mb-3" aria-hidden="true">“</span>
                        <p class="display-5 mb-4">
                            Northline gave sales and delivery one shared path from the first website enquiry to project kickoff.
                        </p>
                        <footer class="d-flex align-items-center gap-3">
                            <img
                                src="/website_webkit/static/src/img/demo/sophie-lambert.svg"
                                class="img webkit_avatar rounded-circle"
                                alt="Portrait of Sophie Lambert"
                                loading="lazy"
                            />
                            <span>
                                <strong class="d-block">Sophie Lambert</strong>
                                <span>Operations Director, BelgoWorks — fictional demo</span>
                            </span>
                        </footer>
                    </blockquote>
                </div>
                <div class="col-xl-5">
                    <div class="webkit_rating d-flex align-items-center gap-2 mb-4" aria-label="Illustrative workflow outcome">
                        <span class="d-flex gap-1 text-o-color-1" aria-hidden="true">
                            <i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/>
                        </span>
                        <strong>Illustrative workflow outcome</strong>
                    </div>
                    <h2 class="h3 mb-4">Less context lost between teams.</h2>
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="webkit_stat p-3 p-md-4">
                                <strong class="display-6 d-block">32%</strong>
                                <span>fewer manual handoffs</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="webkit_stat p-3 p-md-4">
                                <strong class="display-6 d-block">1</strong>
                                <span>shared customer intake</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="webkit_stat d-flex align-items-center gap-3 p-3 p-md-4">
                                <span class="webkit_stat_icon d-inline-flex align-items-center justify-content-center rounded-circle">
                                    <i class="fa fa-users" aria-hidden="true"/>
                                </span>
                                <span><strong class="d-block">One connected team</strong>Sales, delivery and operations aligned.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
